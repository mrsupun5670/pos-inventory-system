{
  "name": "pos-inventory-system",
  "version": "1.0.0",
  "description": "POS and Inventory Management System built with Electron and SQLite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.neptunemobile.pos",
    "productName": "Neptune Mobile POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!database_backups/**/*",
      "!dist/**/*",
      "!build-output/**/*"
    ],
    "extraResources": [
      {
        "from": "neptune-pos.db",
        "to": "neptune-pos.db",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neptune Mobile POS"
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "electron-reloader": "^1.2.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "better-sqlite3": "^12.4.1"
  }
}
